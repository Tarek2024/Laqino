# انسخ هذا الملف إلى .env في جذر المشروع وعدّل القيم (لا ترفعه لأي مستودع)
DOMAIN=laqino.tech
LAQINO_ADMIN_PHONE=01XXXXXXXXX
LAQINO_ADMIN_PASSWORD=ضع-كلمة-قوية-طويلة
# اختياري: LAQINO_REG_PER_HOUR=5  LAQINO_REG_PER_DAY=200

# --- التحقق من الهاتف عبر واتساب (العميل يبعت الكود على رقم لاقينو) ---
LAQINO_WA_VERIFY=1
LAQINO_WA_NUMBER=01017011170
# لو هتستخدم WhatsApp Cloud API (تأكيد تلقائي): الـ webhook هو https://DOMAIN/api/wa/webhook
# LAQINO_WA_VERIFY_TOKEN=كلمة-سرية-تختارها-وتكتبها-في-Meta
# LAQINO_WA_APP_SECRET=App-Secret-من-لوحة-Meta

# --- إشعارات تطبيق أندرويد (FCM) — اختياري، مقفول إن تركته فارغًا ---
# ضع ملف حساب الخدمة من Firebase داخل الحجم /data (خارج أي مستودع) ثم أزل التعليق:
# LAQINO_FCM_SERVICE_ACCOUNT=/data/fcm-service-account.json

# صفحات /privacy و/terms (Google Play)
LAQINO_CONTACT_NAME=Laqino
LAQINO_SUPPORT_EMAIL=Laqino100@gmail.com
